{
  "name": "housetenerife-whatsapp-bot",
  "version": "1.0.0",
  "description": "WhatsApp AI-консультант House Tenerife (каталог с housetenerife.eu)",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "dev:web": "npm run dev --prefix web",
    "build": "npm ci --prefix web --include=dev && npm run build --prefix web",
    "build:web": "npm run build",
    "sync-db": "node scripts/sync-properties.js",
    "sync-mortgage-rates": "node scripts/sync-mortgage-rates.js",
    "sync-missing": "node scripts/sync-missing-properties.js",
    "enrich-i18n": "node scripts/enrich-properties-i18n.js",
    "validate-urls": "node scripts/validate-catalog-urls.js",
    "test-ai-key": "node scripts/test-ai-key.js",
    "ingest-file-doc": "node scripts/ingest-file-doc.js",
    "test:fixes": "node scripts/test-fixes-dialogs.js",
    "postinstall": "patch-package"
  },
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "better-sqlite3": "^13.0.1",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "franc-min": "^6.2.0",
    "libphonenumber-js": "^1.12.34",
    "mammoth": "^1.12.0",
    "patch-package": "8.0.1",
    "pdf-parse": "^2.4.5",
    "puppeteer": "^24.43.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "1.34.7"
  }
}
