# === Railway: обязательно задайте в Variables ===
# Пароль входа в веб-панель /admin (доп. аккаунт администратора)
ADMIN_CODE=

# Аккаунты менеджеров (каждый входит своим паролем)
# MANAGER_1_NAME=Анна
# MANAGER_1_CODE=1001
# MANAGER_2_NAME=Максим
# MANAGER_2_CODE=1002
# MANAGER_3_NAME=Елена
# MANAGER_3_CODE=1003

# === ИИ для WhatsApp — только GPT через OpenRouter ===
# В Railway Variables обязательно:
#   AI_API_KEY=sk-or-...
#   AI_API_URL=https://openrouter.ai/api/v1/chat/completions
#   AI_MODEL=openai/gpt-4.1-mini
# Альтернативы GPT: openai/gpt-4o-mini | openai/gpt-4.1
# Не-GPT модели (DeepSeek, Llama, openrouter/free) код принудительно заменяет на GPT.

AI_API_KEY=
AI_API_URL=https://openrouter.ai/api/v1/chat/completions
AI_MODEL=openai/gpt-4.1-mini

# WhatsApp менеджера — показывается клиенту при передаче (лиды смотрите в /admin, не в чат)
# MANAGER_WHATSAPP=+34631252060

# Проверка ключа: npm run test-ai-key
# Окно сбора: 3 с на одно сообщение; серия сообщений → один ответ через 6 с от первого
# BOT_REPLY_WAIT_MS=3000
# BOT_REPLY_BATCH_WAIT_MS=6000
# Доп. задержка уже после генерации ответа (мс), по умолчанию 0
# BOT_REPLY_DELAY_MS=0
# Фиксированная задержка для сообщений со ссылками (мс); по умолчанию 3 сек
# LINK_MESSAGE_DELAY_MS=3000
# WhatsApp-чат: 1 запрос к API (без 6 повторов). При 429 — сразу AI_FALLBACK_* если задан
# AI_TEMPERATURE=0.55
# AI_MIN_INTERVAL_MS=400
# AI_CONCURRENCY=6
# Запасной провайдер при 429 (другой ключ / OpenAI-совместимый URL)
# AI_FALLBACK_API_KEY=
# AI_FALLBACK_API_URL=https://api.openai.com/v1/chat/completions
# AI_FALLBACK_MODEL=gpt-4o-mini
# Повторы только для фоновых задач (выжимка менеджеру)
# AI_MAX_RETRIES=8

# Порт HTTP — на Railway НЕ задавайте PORT и BOT_PORT (иначе 502 на сайте)
# Локально: BOT_PORT=3001

# Сессия WhatsApp (отдельная папка от бота SellYourBrick)
# SESSION_PATH=./.wwebjs_auth_ht
# На Railway с Volume: SESSION_PATH=/data/.wwebjs_auth_ht
# SQLite (пользователи + история чатов). По умолчанию рядом с SESSION_PATH: /data/bot.db
# SQLITE_PATH=/data/bot.db
# Лиды в панели «Связь с менеджером» (по умолчанию рядом с SESSION_PATH: /data/handoff-leads.json)
# HANDOFF_LEADS_PATH=/data/handoff-leads.json
# Каталог объектов для бота (по умолчанию data/properties.json; после sync-db положите на Volume при необходимости)
# PROPERTIES_PATH=/data/properties.json
# Chrome для Puppeteer скачивается при сборке Docker-образа (не apt chromium)
# Локально переопределить: PUPPETEER_EXECUTABLE_PATH=...
# Не включайте PUPPETEER_SINGLE_PROCESS=1 без необходимости — ломает расшифровку WhatsApp ciphertext

# Таймаут CDP Puppeteer (мс); дефолт 120000 (2 мин) — зависший evaluate отпускает CDP быстрее
# PROTOCOL_TIMEOUT_MS=120000
# WA_SEND_SOFT_TIMEOUT_MS=45000  — не ждать 2 мин × 3 метода на мёртвом CDP
# WA_OUTBOUND_RETRY_MAX=8
# При «Runtime.callFunctionOn timed out» / watchdog probe timeout:
# — глобальный CDP mutex: пока getChats висит, новые evaluate не стартуют
# — soft-timeout getChats (POLLING_GETCHATS_TIMEOUT_MS) НЕ рвёт сессию: только cooldown
# — recovery только при hard protocolTimeout / мёртвом browser (WA_CDP_RECOVERY=1)
# — session watch ВЫКЛ по умолчанию (WA_SESSION_WATCH_MS=0)
# — polling auto-off 30 мин после message events (POLLING_AUTO_OFF_QUIET_MS)
# — полностью выкл polling: DISABLE_POLLING=1
# WA_SESSION_WATCH_MS=0
# POLLING_INTERVAL_MS=15000
# POLLING_GETCHATS_TIMEOUT_MS=25000
# POLLING_AUTO_OFF=1
# POLLING_AUTO_OFF_QUIET_MS=1800000
# DISABLE_POLLING=0
# WA_CDP_RECOVERY=1
# WA_CDP_RECOVERY_MS=900000
# WA_CDP_RECOVERY_IDLE_MS=1200000
# WA_CDP_RECOVERY_MIN_HANGS=3

# Веб-поиск через DuckDuckGo включён для «актуальных» вопросов; полностью отключить:
# DISABLE_WEB_SEARCH=1

# Синхронизация каталога (scripts/sync-properties.js)
# Берёт все property-sitemap* из https://housetenerife.eu/sitemap_index.xml
# SYNC_DELAY_MS=2000
# SYNC_MAX_INDEX_PAGES=600
# SYNC_MAX_PROPERTIES=5000
# SYNC_SKIP_INDEX_CRAWL=1   # достаточно sitemap (рекомендуется; индекс — доп. обход)
# SYNC_RETRIES=3
# SYNC_EXTRA_LANGS=es,de,fr,pl,nl
# sync-db: sitemap + опционально регионы (catalog-regions.js SYNC_SEED_INDEX_URLS)

# === Telegram: мониторинг и команды ===
# 1) @BotFather → /newbot → TELEGRAM_BOT_TOKEN
# 2) Добавьте бота в группу (или пишите в личку)
# 3) Узнайте chat_id: напишите боту, откройте https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=5297732754
# Важно: напишите боту /start — иначе Telegram вернёт «chat not found»
# Chat id можно узнать: /whoami (сохранится автоматически в data/telegram-known-chats.json)
# Несколько чатов для алертов (личка + группа): через запятую или TELEGRAM_ALERT_CHAT_IDS
# TELEGRAM_ALERT_CHAT_IDS=5297732754,-1001234567890
# На Railway webhook включается автоматически (RAILWAY_PUBLIC_DOMAIN)
# Локально: TELEGRAM_USE_WEBHOOK=0 (long-polling) или PUBLIC_BASE_URL=https://...
# TELEGRAM_WEBHOOK_URL=https://your-domain.com
# WA_SESSION_WATCH_MS=0  — по умолчанию выкл (только disconnected); включить: 60000
# WA_SESSION_PROBE_TIMEOUT_MS=30000  — мягкий таймаут одной проверки (не считается отключением)
# WA_SESSION_MAX_ERRORS=3  — алерт после последовательных фатальных ошибок
# TELEGRAM_NOTIFY_EVERY_MESSAGE=1  — алерт в Telegram на каждое WA-сообщение (0 = выкл)
# Команды /ai /status /help: по умолчанию из лички и групп Telegram.
# Ограничить список: TELEGRAM_CMD_CHAT_IDS=5297732754,-1001234567890
# TELEGRAM_CMD_CHAT_IDS=-1001234567890
# TELEGRAM_CHAT_ID для уведомлений: личка (5297732754) или группа (-100…); в группе: /whoami
# TELEGRAM_ALERTS_PATH=./data/telegram-alerts.json

# === WhatsApp: групповые чаты ===
# WHATSAPP_REPLY_IN_GROUPS=1   # по умолчанию включено
# WHATSAPP_GROUP_ONLY_MENTION=1  # только при @бот или reply на его сообщение
